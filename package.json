{
  "name": "ridecontrol",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun run cf dev",
    "build": "tsc && bun run cf build",
    "check": "biome check . --error-on-warnings",
    "fix": "biome check --write .",
    "test": "bun test",
    "tailwind:check": "bun scripts/check-tailwind.ts",
    "ci": "biome check . --error-on-warnings && bun run tailwind:check && bun test && tsc --noEmit && bun run cf build",
    "deploy": "bun run build && bun run cf deploy --prebuilt --mode production",
    "preview": "CF_SEND_TELEMETRY=false DO_NOT_TRACK=1 vite preview --host localhost --port 4200",
    "cf": "CF_SEND_TELEMETRY=false DO_NOT_TRACK=1 cf"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/modifiers": "9.0.0",
    "@dnd-kit/sortable": "10.0.0",
    "@garmin/fitsdk": "21.217.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/charts": "0.18.0",
    "@tanstack/react-charts": "0.18.0",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-router": "1.170.40",
    "@tanstack/react-store": "0.11.2",
    "@tanstack/react-virtual": "3.14.13",
    "@vitejs/plugin-react": "6.1.1",
    "d3-scale": "4.0.2",
    "fflate": "0.8.3",
    "leaflet": "1.9.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@cloudflare/vite-plugin": "2.0.0-beta.sha-ad79608dd",
    "@tailwindcss/language-server": "0.16.0",
    "@types/bun": "1.4.2",
    "@types/d3-scale": "4.0.9",
    "@types/leaflet": "1.9.22",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/web-bluetooth": "0.0.21",
    "@xmldom/xmldom": "0.9.12",
    "cf": "1.0.0-beta.5",
    "fake-indexeddb": "6.2.5",
    "typescript": "7.0.2",
    "ultracite": "7.12.2",
    "vite": "8.3.1"
  },
  "packageManager": "bun@1.4.2"
}
